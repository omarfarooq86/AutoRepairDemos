---
export interface Props {
  shop: { shortName: string };
  style: 'industrial' | 'modern';
}

const { shop, style } = Astro.props;

// Structural site navigation — fixed labels/hrefs, not business content.
const navLinks = [
  { label: 'Services', href: '#services' },
  { label: 'About', href: '#about' },
  { label: 'Process', href: '#process' },
  { label: 'Reviews', href: '#reviews' },
  { label: 'FAQ', href: '#faq' },
  { label: 'Contact', href: '#contact' },
];
---

<nav class={`navbar navbar--${style}`} id="top" aria-label="Primary navigation">
  <div class="navbar-inner">
    <a href="#top" class="navbar-logo">{shop.shortName}</a>

    <!-- CSS-only hamburger: the hidden checkbox toggles the mobile menu via
         input:checked ~ .nav-links. No JavaScript required. -->
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />

    <ul class="nav-links">
      {navLinks.map((link) => (
        <li class="nav-item">
          <a href={link.href} class="nav-link">{link.label}</a>
        </li>
      ))}
    </ul>

    <label for="nav-toggle" class="nav-burger" aria-label="Toggle navigation menu">
      <span class="nav-burger-bar"></span>
      <span class="nav-burger-bar"></span>
      <span class="nav-burger-bar"></span>
    </label>
  </div>
</nav>

<style>
  /* Minimal functional navbar CSS — sticky bar + CSS-only hamburger toggle.
     Per-demo themed styling (colors, fonts, shadows) is added in
     demo-1.css / demo-2.css (Tasks 14/15). Colors here use the theme
     custom properties from global.css so the bar themes out of the box. */

  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg, #1a1a1a);
    border-bottom: 1px solid var(--color-border, #333);
  }

  .navbar-inner {
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .navbar-logo {
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .navbar-logo:hover {
    color: var(--color-accent, #f97316);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .nav-link {
    font-size: 0.82rem;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .nav-link:hover {
    color: var(--color-accent, #f97316);
  }

  /* --- Hamburger (checkbox hack) --- */
  .nav-toggle {
    display: none;
  }

  .nav-burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 10px 2px;
  }
  .nav-burger-bar {
    display: block;
    width: 26px;
    height: 2px;
    background: currentColor;
  }

  @media (max-width: 768px) {
    .nav-burger {
      display: flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--color-bg, #1a1a1a);
      border-bottom: 1px solid var(--color-border, #333);
    }
    .nav-toggle:checked ~ .nav-links {
      display: flex;
    }

    .nav-link {
      display: block;
      padding: 14px 20px;
      border-top: 1px solid var(--color-border, #333);
    }
  }
</style>
