---
export interface GalleryItem {
  title: string;
  category: string;
  image: string;
}

export interface Props {
  gallery: GalleryItem[];
  style: 'industrial' | 'modern';
}

const { gallery, style } = Astro.props;
---

<section class={`gallery gallery--${style}`} id="gallery">
  <h2 class="section-heading" data-reveal>Recent Work</h2>
  <div class="gallery-grid">
    {gallery.map((item) => (
      <figure class="gallery-item" data-reveal>
        <img src={item.image} alt={item.title} loading="lazy" width="900" height="675" />
        <figcaption class="gallery-overlay">
          <span class="gallery-cat">{item.category}</span>
          <span class="gallery-title">{item.title}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  /* Minimal functional gallery grid — image zoom + overlay slide-up on
     hover. Colors/themed detail live in demo-1.css / demo-2.css. */

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .gallery-item {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-border, #333);
    cursor: pointer;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), filter 0.4s ease;
  }

  .gallery-item:hover img,
  .gallery-item:focus-within img {
    transform: scale(1.07);
  }

  .gallery-overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: 40px 18px 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.82) 100%);
    transform: translateY(30%);
    opacity: 0;
    transition: transform 0.35s ease, opacity 0.35s ease;
  }

  .gallery-item:hover .gallery-overlay,
  .gallery-item:focus-within .gallery-overlay {
    transform: translateY(0);
    opacity: 1;
  }

  .gallery-cat {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-accent, #f97316);
  }

  .gallery-title {
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
  }

  /* Touch devices have no hover — always show the caption */
  @media (hover: none) {
    .gallery-overlay {
      transform: none;
      opacity: 1;
    }
  }

  @media (max-width: 900px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>
