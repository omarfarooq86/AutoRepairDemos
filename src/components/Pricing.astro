---
export interface PricingPackage {
  name: string;
  price: string;
  note: string;
  popular?: boolean;
  features: string[];
}

export interface Props {
  packages: PricingPackage[];
  contact: { phone: string };
  style: 'industrial' | 'modern';
}

const { packages, contact, style } = Astro.props;
---

<section class={`pricing pricing--${style}`} id="pricing">
  <h2 class="section-heading" data-reveal>Service Packages</h2>
  <div class="pricing-grid">
    {packages.map((pkg) => (
      <article class={`price-card${pkg.popular ? ' price-card--popular' : ''}`} data-reveal>
        {pkg.popular && <span class="price-flag">Most Popular</span>}
        <h3 class="price-name">{pkg.name}</h3>
        <p class="price-value">{pkg.price}</p>
        <p class="price-note">{pkg.note}</p>
        <ul class="price-features">
          {pkg.features.map((feature) => (
            <li>{feature}</li>
          ))}
        </ul>
        <a href={`tel:${contact.phone}`} class="price-cta">Call to Book</a>
      </article>
    ))}
  </div>
</section>

<style>
  /* Minimal functional pricing grid. Popular-card highlight, borders, and
     button colors are themed in demo-1.css / demo-2.css. */

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  .price-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border, #333);
    background: var(--color-bg, #fff);
    padding: 32px 24px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .price-flag {
    position: absolute;
    top: -13px;
    left: 50%;
    transform: translateX(-50%);
    padding: 5px 16px;
    border-radius: 100px;
    background: var(--color-accent, #f97316);
    color: var(--color-bg, #fff);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .price-name {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .price-value {
    font-size: clamp(1.7rem, 3.5vw, 2.2rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--color-accent, #f97316);
  }

  .price-note {
    font-size: 0.78rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color-muted, #888);
    margin: 6px 0 20px;
  }

  .price-features {
    list-style: none;
    margin: 0 0 24px;
    padding: 20px 0 0;
    border-top: 1px solid var(--color-border, #333);
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-align: left;
    flex-grow: 1;
  }

  .price-features li {
    position: relative;
    padding-left: 26px;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-muted, #888);
  }

  .price-features li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    font-weight: 700;
    color: var(--color-accent, #f97316);
  }

  .price-cta {
    display: inline-block;
    padding: 12px 24px;
    border: 1px solid var(--color-accent, #f97316);
    border-radius: 4px;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: var(--color-accent, #f97316);
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .price-cta:hover {
    background: var(--color-accent, #f97316);
    color: var(--color-bg, #fff);
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      max-width: 440px;
      margin: 0 auto;
    }
    .price-card--popular {
      /* keep the flag visible when stacked */
      margin-top: 13px;
    }
  }
</style>
