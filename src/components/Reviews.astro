---
export interface Props {
  reviews: { name: string; rating: number; text: string; date: string }[];
  style: 'industrial' | 'modern';
}

// Minimal bridge for the v2 data schema (reviews are now an array of {name, rating, text, date} cards).
// Task 10 replaces this component with the full enhanced version.
const { reviews, style } = Astro.props;

function stars(rating: number): string {
  return '★'.repeat(Math.floor(rating)) + (rating % 1 >= 0.5 ? '½' : '');
}
---

<section class="reviews">
  <h2 class="section-heading">What Our Customers Say</h2>
  <div class="reviews-grid">
    {reviews.map((review) => (
      <div class="review-card">
        <div class="review-stars">{stars(review.rating)}</div>
        <blockquote class="review-quote">&ldquo;{review.text}&rdquo;</blockquote>
        <p class="review-meta"><strong>{review.name}</strong> &mdash; {review.date}</p>
      </div>
    ))}
  </div>
</section>
