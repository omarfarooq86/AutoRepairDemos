---
export interface Props {
  reviews: { name: string; rating: number; text: string; date: string }[];
  style: 'industrial' | 'modern';
}

const { reviews, style } = Astro.props;
const total = reviews.length;

function stars(rating: number): string {
  return '★'.repeat(Math.floor(rating)) + (rating % 1 >= 0.5 ? '½' : '');
}
---

<section class="reviews" id="reviews">
  <h2 class="section-heading">What Our Customers Say</h2>
  <div class="reviews-carousel" role="region" aria-label="Customer reviews" aria-roledescription="carousel">
    {reviews.map((review, i) => (
      <div
        class="review-card"
        style={`--carousel-index: ${i}; --carousel-total: ${total};`}
        role="group"
        aria-roledescription="slide"
        aria-label={`Review ${i + 1} of ${total}`}
      >
        <div class="review-stars">{stars(review.rating)}</div>
        <blockquote class="review-quote">&ldquo;{review.text}&rdquo;</blockquote>
        <p class="review-meta"><strong>{review.name}</strong> &mdash; {review.date}</p>
      </div>
    ))}
  </div>
</section>

<style>
  /* ===== CSS-Only Review Carousel =====
     Uses keyframe animation with staggered delays.
     Each card is visible for ~28% of the cycle, then slides out.
     Cards share the same animation with delay offsets.
     Pause on hover via animation-play-state. */

  .reviews-carousel {
    position: relative;
    overflow: hidden;
    min-height: 180px;
  }

  .review-card {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    transform: translateX(40px);
    pointer-events: none;
    display: flex;
    flex-direction: column;
    background: var(--color-bg, #1a1a1a);
    border: 1px solid var(--color-border, #333);
    padding: 28px;
    animation: reviewCycle calc(var(--carousel-total, 3) * 5s) ease-in-out infinite;
    animation-delay: calc(var(--carousel-index, 0) * 5s);
  }

  .review-card:hover ~ .review-card,
  .reviews-carousel:hover .review-card {
    animation-play-state: paused;
  }

  @keyframes reviewCycle {
    0% {
      opacity: 0;
      transform: translateX(40px);
      pointer-events: none;
      z-index: 0;
    }
    4% {
      opacity: 1;
      transform: translateX(0);
      pointer-events: auto;
      z-index: 2;
    }
    28% {
      opacity: 1;
      transform: translateX(0);
      pointer-events: auto;
      z-index: 2;
    }
    33% {
      opacity: 0;
      transform: translateX(-30px);
      pointer-events: none;
      z-index: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(-30px);
      pointer-events: none;
      z-index: 0;
    }
  }

  .review-stars {
    color: var(--color-accent, #f97316);
    font-size: 1.2rem;
    margin-bottom: 12px;
    flex-shrink: 0;
  }

  .review-quote {
    font-size: 1.05rem;
    color: var(--color-muted, #888);
    font-style: italic;
    line-height: 1.6;
    margin: 0 0 16px;
    flex-grow: 1;
  }

  .review-meta {
    font-size: 0.9rem;
    color: var(--color-muted, #888);
    margin: 0;
  }

  .review-meta strong {
    color: var(--color-accent, #f97316);
  }

  /* Reduced motion: show all cards stacked without animation */
  @media (prefers-reduced-motion: reduce) {
    .reviews-carousel {
      overflow: visible;
    }
    .review-card {
      position: static;
      opacity: 1;
      transform: none;
      pointer-events: auto;
      animation: none;
      margin-bottom: 16px;
      z-index: auto;
    }
  }

  @media (max-width: 768px) {
    .reviews-carousel {
      min-height: 220px;
    }
  }
</style>
