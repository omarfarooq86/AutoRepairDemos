---
export interface Shop {
  name: string;
  shortName: string;
  tagline: string;
  established: string | null;
  municipality: string;
}

export interface ContactData {
  phone: string;
  displayPhone: string;
}

export interface ReviewData {
  rating: number;
}

export interface Props {
  shop: Shop;
  contact: Pick<ContactData, 'phone' | 'displayPhone'>;
  reviews: ReviewData[];
  style: 'industrial' | 'modern';
}

const { shop, contact, reviews, style } = Astro.props;

// Minimal bridge for the v2 data schema (reviews are now an array of cards).
// Task 4 replaces this component with the full enhanced version using shop.stats + hero.badges.
const count = reviews.length;
const avgRating = count ? reviews.reduce((sum, r) => sum + r.rating, 0) / count : 0;
const rating = Math.round(avgRating * 10) / 10;
---

<section class="hero">
  <div class="hero-inner">
    {style === 'industrial' ? (
      <>
        <p class="hero-est">{shop.established ? `Est. ${shop.established}` : ''}{shop.established && shop.municipality ? ' · ' : ''}{shop.municipality}</p>
        <h1 class="hero-name">{shop.shortName}</h1>
        <div class="hero-line"></div>
        <p class="hero-tagline">{shop.tagline}</p>
      </>
    ) : (
      <>
        <span class="hero-badge">★ {rating} · {count} Reviews</span>
        <h1 class="hero-name">{shop.name}</h1>
        <p class="hero-tagline">{shop.tagline}</p>
      </>
    )}
    <a href={`tel:${contact.phone}`} class="hero-cta">Call Now — {contact.displayPhone}</a>
    {style === 'industrial' && (
      <p class="hero-reviews">★ {rating} ({count} reviews)</p>
    )}
  </div>
</section>
