---
export interface Shop {
  name: string;
  shortName: string;
  tagline: string;
  established: string | null;
  municipality: string;
  stats?: Array<{ label: string; value: string }>;
}

export interface HeroData {
  headline?: string;
  subheadline?: string;
  badges?: string[];
  image?: string;
}

export interface ContactData {
  phone: string;
  displayPhone: string;
}

export interface ReviewData {
  rating: number;
}

export interface Props {
  shop: Shop;
  hero?: HeroData;
  contact: Pick<ContactData, 'phone' | 'displayPhone'>;
  reviews?: ReviewData[];
  style: 'industrial' | 'modern';
}

const { shop, hero, contact, reviews, style } = Astro.props;

// Rich v2 copy from hero.headline / hero.subheadline, falling back to the
// v1 name / tagline so the component keeps working without a `hero` prop.
const headline = hero?.headline ?? shop.name;
const subheadline = hero?.subheadline ?? shop.tagline;
const badges = hero?.badges ?? [];
const stats = shop.stats ?? [];

// hero.image is injected as a CSS custom property so the themed stylesheets
// (demo-1.css / demo-2.css) can composite it with their own overlays, and the
// modern hero can render it as an <img> inside the visual column.
const heroImage = hero?.image;
const heroInnerStyle = heroImage ? `--hero-image: url('${heroImage}')` : undefined;

const count = reviews?.length ?? 0;
const avgRating = count ? reviews.reduce((sum, r) => sum + r.rating, 0) / count : 0;
const rating = Math.round(avgRating * 10) / 10;
---

<section class="hero">
  <div class="hero-inner" style={heroInnerStyle}>
    {style === 'industrial' ? (
      <>
        <div class="hero-gears" aria-hidden="true">
          <div class="hero-gear hero-gear--1"></div>
          <div class="hero-gear hero-gear--2"></div>
          <div class="hero-gear hero-gear--3"></div>
          <div class="hero-gear hero-gear--4"></div>
        </div>
        <p class="hero-est" data-reveal>{shop.established ? `Est. ${shop.established}` : ''}{shop.established && shop.municipality ? ' · ' : ''}{shop.municipality}</p>
        <h1 class="hero-name" data-reveal>{headline}</h1>
        <div class="hero-line" data-reveal></div>
        <p class="hero-tagline" data-reveal>{subheadline}</p>
        <div class="hero-ctas" data-reveal>
          <a href={`tel:${contact.phone}`} class="hero-cta">Call Now — {contact.displayPhone}</a>
          <a href="#services" class="hero-cta-secondary">Explore Services</a>
        </div>
        <p class="hero-reviews" data-reveal>★ {rating} ({count} reviews)</p>
        {badges.length > 0 && (
          <ul class="hero-badges" aria-label="Highlights" data-reveal>
            {badges.map((badge) => (
              <li class="hero-badge-pill">{badge}</li>
            ))}
          </ul>
        )}
      </>
    ) : (
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="hero-badge" data-reveal>★ {rating} · {count} Reviews</span>
          <h1 class="hero-name" data-reveal>{headline}</h1>
          <p class="hero-tagline" data-reveal>{subheadline}</p>
          <div class="hero-ctas" data-reveal>
            <a href={`tel:${contact.phone}`} class="hero-cta">Call Now — {contact.displayPhone}</a>
            <a href="#services" class="hero-cta-secondary">Explore Services</a>
          </div>
          {badges.length > 0 && (
            <ul class="hero-badges" aria-label="Highlights" data-reveal>
              {badges.map((badge) => (
                <li class="hero-badge-pill">{badge}</li>
              ))}
            </ul>
          )}
        </div>
        {heroImage && (
          <div class="hero-visual" data-reveal>
            <div class="hero-visual-blob" aria-hidden="true"></div>
            <img class="hero-visual-img" src={heroImage} alt="Mechanic servicing a car at the workshop" width="1000" height="1100" />
            <div class="hero-chip hero-chip--rating" aria-hidden="true">
              <span class="hero-chip-stars">★★★★★</span>
              <span class="hero-chip-value">{rating}</span>
              <span class="hero-chip-label">Google Rating</span>
            </div>
            <div class="hero-chip hero-chip--open" aria-hidden="true">
              <span class="hero-pulse"></span>24/7 Open
            </div>
          </div>
        )}
      </div>
    )}
  </div>

  {stats.length > 0 && (
    <div class="hero-stats" role="list">
      {stats.map((stat) => (
        <div class="hero-stat" role="listitem">
          <span class="hero-stat-value" data-count>{stat.value}</span>
          <span class="hero-stat-label">{stat.label}</span>
        </div>
      ))}
    </div>
  )}
</section>

<style>
  /* ===== Minimal functional styling for the v3 additions =====
     Only layout + neutral colors via theme custom properties, so both demos
     render correctly out of the box. Themed look (orange vs blue accents,
     borders, hover) is applied in demo-1.css / demo-2.css. */

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .hero-cta-secondary {
    display: inline-block;
    padding: 14px 28px;
    border: 1px solid var(--color-border, #333);
    border-radius: 2px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color-text, inherit);
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .hero-cta-secondary:hover {
    border-color: var(--color-accent, #f97316);
    color: var(--color-accent, #f97316);
  }

  /* --- Modern split hero (visual column) --- */
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: center;
    width: 100%;
  }

  .hero-visual {
    position: relative;
  }

  .hero-visual-img {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 10 / 11;
    object-fit: cover;
    border-radius: 24px;
  }

  /* Soft accent glow behind the photo */
  .hero-visual-blob {
    position: absolute;
    inset: -6% -8%;
    background: radial-gradient(closest-side, var(--color-accent, #1e40af), transparent 70%);
    opacity: 0.16;
    filter: blur(40px);
    animation: blobDrift 9s ease-in-out infinite alternate;
  }

  /* Floating info chips over the photo */
  .hero-chip {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 14px;
    border: 1px solid var(--color-border, #e5e7eb);
    background: var(--color-bg, #fff);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12);
    font-size: 0.85rem;
    font-weight: 700;
    animation: chipFloat 6s ease-in-out infinite;
  }

  .hero-chip--rating {
    top: 7%;
    left: -28px;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }
  .hero-chip-stars {
    color: #f59e0b;
    font-size: 0.75rem;
    letter-spacing: 2px;
  }
  .hero-chip-value {
    font-size: 1.4rem;
    font-weight: 800;
    line-height: 1;
  }
  .hero-chip-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color-muted, #64748b);
  }

  .hero-chip--open {
    bottom: 8%;
    right: -16px;
    animation-delay: -3s;
  }

  .hero-pulse {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #22c55e;
    animation: pulseRing 2s ease-out infinite;
  }

  @keyframes chipFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  @keyframes blobDrift {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(4%, 5%) scale(1.08); }
  }
  @keyframes pulseRing {
    0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5); }
    70% { box-shadow: 0 0 0 9px rgba(34, 197, 94, 0); }
    100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
  }

  .hero-badges {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hero-badge-pill {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 100px;
    border: 1px solid var(--color-border, #333);
    background: color-mix(in srgb, var(--color-bg, #fff) 70%, transparent);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--color-border, #333);
    border-top: 1px solid var(--color-border, #333);
  }

  .hero-stat {
    background: var(--color-bg, #fff);
    padding: 20px 16px;
    text-align: center;
  }

  .hero-stat-value {
    display: block;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    line-height: 1;
  }

  .hero-stat-label {
    display: block;
    margin-top: 6px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-muted, #888);
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero-visual {
      max-width: 460px;
      margin: 0 auto;
      width: 100%;
    }
    .hero-chip--rating {
      left: -8px;
    }
    .hero-chip--open {
      right: -8px;
    }
  }

  @media (max-width: 640px) {
    .hero-stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-chip,
    .hero-visual-blob,
    .hero-pulse {
      animation: none;
    }
  }
</style>
