---
export interface Props {
  shop: { name: string };
  services: Array<{ name: string }>;
  contact: { phone: string; displayPhone: string; hours: string };
  style: 'industrial' | 'modern';
}

const { shop, services, contact, style } = Astro.props;

// Structural site navigation — fixed labels/hrefs (same anchors as the Navbar).
const quickLinks = [
  { label: 'Services', href: '#services' },
  { label: 'About', href: '#about' },
  { label: 'Process', href: '#process' },
  { label: 'Reviews', href: '#reviews' },
  { label: 'FAQ', href: '#faq' },
  { label: 'Contact', href: '#contact' },
];

const year = new Date().getFullYear();
---

<footer class={`site-footer site-footer--${style}`} id="footer">
  <div class="footer-grid">
    <!-- Col 1: Quick Links (anchor links) -->
    <div class="footer-col">
      <h3 class="footer-heading">Quick Links</h3>
      <ul class="footer-links">
        {quickLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Col 2: Our Services (list of service names from data) -->
    <div class="footer-col">
      <h3 class="footer-heading">Our Services</h3>
      <ul class="footer-links">
        {services.map((service) => (
          <li>
            <a href="#services">{service.name}</a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Col 3: Contact Info (phone + hours) -->
    <div class="footer-col">
      <h3 class="footer-heading">Contact</h3>
      <ul class="footer-links">
        <li>
          <a href={`tel:${contact.phone}`}>{contact.displayPhone}</a>
        </li>
        <li>{contact.hours}</li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <span class="footer-copyright">© {year} {shop.name}. All rights reserved.</span>
    <span class="footer-credit">Built by <strong>Veloxa</strong></span>
  </div>
</footer>

<style>
  /* Minimal functional styling for the 3-column footer. Colors use the theme
     custom properties from global.css with fallbacks so the footer themes out
     of the box. Per-demo themed styling (colors, fonts, accents) is added in
     demo-1.css / demo-2.css (Tasks 14/15). */

  .site-footer {
    border-top: 1px solid var(--color-border, #333);
    background: var(--color-bg, #1a1a1a);
  }

  .footer-grid {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 20px 32px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .footer-heading {
    margin: 0 0 12px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-accent, #f97316);
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.9rem;
  }

  .footer-links a:hover {
    color: var(--color-accent, #f97316);
  }

  .footer-bottom {
    max-width: 1100px;
    margin: 0 auto;
    padding: 16px 20px;
    border-top: 1px solid var(--color-border, #333);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.8rem;
    color: var(--color-muted, #888);
  }

  .footer-credit strong {
    color: var(--color-accent, #f97316);
  }

  /* Stack the three columns on small screens. */
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      justify-content: center;
      text-align: center;
    }
  }
</style>
