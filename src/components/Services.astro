---
export interface Props {
  services: { name: string; icon: string; description: string }[];
  style: 'industrial' | 'modern';
}

// Minimal bridge for the v2 data schema (services are now {name, icon, description} objects).
// Task 5 replaces this component with the full enhanced version.
const ICONS: Record<string, string> = {
  engine: '\u{1F69B}',
  body: '\u{1F697}',
  restoration: '\u{1F3A8}',
  paint: '\u{1F3A8}',
  brake: '\u{1F6E0}\u{FE0F}',
  diagnostics: '\u{1F50D}',
  ac: '\u{2744}\u{FE0F}',
  electrical: '\u{1F4A1}',
  oil: '\u{1F6E2}\u{FE0F}',
  inspection: '\u{1F50D}',
};

function getIcon(icon: string): string {
  return ICONS[icon] ?? '\u{1F527}'; // default: wrench
}

const { services, style } = Astro.props;
---

<section class="services">
  <h2 class="section-heading">Our Services</h2>
  <div class="services-grid">
    {services.map((svc) => (
      <div class="service-card">
        {style === 'modern' && <span class="service-icon">{getIcon(svc.icon)}</span>}
        <span class="service-label">{svc.name}</span>
        {svc.description && <p class="service-desc">{svc.description}</p>}
      </div>
    ))}
  </div>
</section>
