---
import '../styles/demo-2.css';
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import Services from '../components/Services.astro';
import Gallery from '../components/Gallery.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import About from '../components/About.astro';
import WorkProcess from '../components/WorkProcess.astro';
import Pricing from '../components/Pricing.astro';
import Team from '../components/Team.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import data from '../data/demo-2.json';

const { shop, hero, contact, services, brands, gallery, team, packages, reviews, whyChooseUs, workProcess, faqs, style } = data;
---

<Base title={shop.name} style={style}>
  <Navbar shop={shop} style={style} />
  <Hero shop={shop} hero={hero} contact={contact} reviews={reviews} style={style} />
  <BrandMarquee brands={brands} style={style} />
  <Services services={services} style={style} />
  <Gallery gallery={gallery} style={style} />
  <WhyChooseUs whyChooseUs={whyChooseUs} style={style} />
  <About shop={shop} style={style} />
  <WorkProcess workProcess={workProcess} style={style} />
  <Pricing packages={packages} contact={contact} style={style} />
  <Team team={team} style={style} />
  <CtaBanner contact={contact} style={style} />
  <Reviews reviews={reviews} style={style} />
  <Faq faqs={faqs} style={style} />
  <Contact contact={contact} style={style} />
  <Footer shop={shop} services={services} contact={contact} style={style} />
  <BackToTop style={style} />
</Base>
